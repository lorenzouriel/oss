# Copy to .env to override the local-development defaults in docker-compose.yml.

# Host ports (Postgres/Airflow avoid the streaming stack's 5432/8080)
POSTGRES_PORT=5433
AIRFLOW_PORT=8088
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
POLARIS_PORT=8181
POLARIS_MGMT_PORT=8182
OPENMETADATA_PORT=8585
OPENMETADATA_ADMIN_PORT=8586

POSTGRES_PASSWORD=postgres

AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_BUCKET=lakehouse
S3_REGION=us-east-1

POLARIS_CATALOG=lakehouse
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=s3cr3t
